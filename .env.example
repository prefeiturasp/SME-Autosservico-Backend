# Copie este arquivo para ".env" e ajuste os valores conforme o ambiente.
# Não coloque aqui hosts internos, portas reais de produção ou segredos
# verdadeiros — apenas placeholders descritivos.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=sua-chave-secreta-aqui
DJANGO_ADMIN_URL=admin/
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Autenticação por chave de API (serviço-a-serviço)
API_KEY=sua-chave-de-api-aqui
API_KEY_HEADER=X-Api-Key

# Leitura somente-leitura do banco do SIGPAE (métricas). Inclua
# connect_timeout e sslmode=prefer (o servidor não suporta SSL).
# SIGPAE_DSN=postgresql://usuario:senha@host:porta/db-sigpae?sslmode=prefer&connect_timeout=5

# Banco de dados — se não definido, usa um arquivo SQLite local (db.sqlite3).
# Para usar Postgres futuramente:
# DATABASE_URL=postgres://usuario:senha@host_do_banco:porta/nome_do_banco

# Variáveis usadas apenas fora de DEBUG (produção)
# CONN_MAX_AGE=60
# CSRF_TRUSTED_ORIGINS=https://dominio-do-frontend-em-producao
